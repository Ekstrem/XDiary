{
  "openapi": "3.0.1",
  "info": {
    "title": "AppleHealthGateway.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/apple-health/configure": {
      "post": {
        "tags": [
          "AppleHealthGateway"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigureCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigureCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigureCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "operationId": "AppleHealthGateway.Configure"
      }
    },
    "/api/v1/apple-health/import": {
      "post": {
        "tags": [
          "AppleHealthGateway"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportFileCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportFileCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ImportFileCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "operationId": "AppleHealthGateway.ImportFile"
      }
    },
    "/api/v1/apple-health/state": {
      "get": {
        "tags": [
          "AppleHealthGateway"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "operationId": "AppleHealthGateway.State"
      }
    }
  },
  "components": {
    "schemas": {
      "ConfigureCommand": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string",
            "format": "uuid"
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ImportFileCommand": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}
