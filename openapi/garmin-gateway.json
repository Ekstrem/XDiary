                  "$ref": "#/components/schemas/GarminConnectionState"
                }
              }
            }
          },
          "400": {
            "description": "validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GarminApiError"
                }
              }
            }
          },
          "401": {
            "description": "no-token"
          },
