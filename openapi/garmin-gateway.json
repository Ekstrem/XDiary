{
  "openapi": "3.0.1",
  "info": {
    "title": "GarminGateway.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/garmin/connect": {
      "post": {
        "tags": [
          "GarminGateway"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "operationId": "GarminGateway.Connect"
      }
    },
    "/api/v1/garmin/sync": {
      "post": {
        "tags": [
          "GarminGateway"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SyncCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "operationId": "GarminGateway.Sync"
      }
    },
    "/api/v1/garmin/fetch-activities": {
      "post": {
        "tags": [
          "GarminGateway"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "operationId": "GarminGateway.FetchActivities"
      }
    },
    "/api/v1/garmin/state": {
      "get": {
        "tags": [
          "GarminGateway"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "operationId": "GarminGateway.State"
      }
    }
  },
  "components": {
    "schemas": {
      "ConnectCommand": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string",
            "format": "uuid"
          },
          "credentials": {
            "$ref": "#/components/schemas/CredentialsDto"
          }
        },
        "additionalProperties": false
      },
      "CredentialsDto": {
        "type": "object",
        "properties": {
          "apiKey": {
            "type": "string",
            "nullable": true
          },
          "oauthToken": {
            "type": "string",
            "nullable": true
          },
          "tokenExpiry": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SyncCommand": {
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string",
            "format": "uuid"
          },
          "config": {
            "$ref": "#/components/schemas/SyncConfigDto"
          }
        },
        "additionalProperties": false
      },
      "SyncConfigDto": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "windowDays": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
