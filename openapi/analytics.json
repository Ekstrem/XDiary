{
  "components": {
    "schemas": {
      "AnalyticsEvent": {
        "additionalProperties": false,
        "properties": {
          "bodyBattery": {
            "format": "int32",
            "type": "integer"
          },
          "date": {
            "nullable": true,
            "type": "string"
          },
          "eventType": {
            "nullable": true,
            "type": "string"
          },
          "hr": {
            "format": "int32",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "record": {
            "$ref": "#/components/schemas/JournalRecord"
          },
          "sleepScore": {
            "format": "int32",
            "type": "integer"
          },
          "stress": {
            "format": "int32",
            "type": "integer"
          },
          "t": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "JournalRecord": {
        "additionalProperties": false,
        "properties": {
          "durationMin": {
            "format": "int32",
            "type": "integer"
          },
          "fantasies": {
            "items": {
              "type": "string"
            },
            "nullable": true,
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "orgasms": {
            "items": {
              "$ref": "#/components/schemas/OrgasmDto"
            },
            "nullable": true,
            "type": "array"
          },
          "partners": {
            "items": {
              "type": "string"
            },
            "nullable": true,
            "type": "array"
          },
          "place": {
            "nullable": true,
            "type": "string"
          },
          "positions": {
            "items": {
              "type": "string"
            },
            "nullable": true,
            "type": "array"
          },
          "startedAt": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "OrgasmDto": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "format": "int32",
            "type": "integer"
          },
          "participant": {
            "nullable": true,
            "type": "string"
          },
          "rating": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "BC-Analytics: read-only аналитика (проекции над Журналом и Соматикой). CEQRS, профиль Single.",
    "title": "Analytics Microservice API",
    "version": "v1"
  },
  "openapi": "3.0.1",
  "paths": {
    "/api/v1/analytics/correlations": {
      "get": {
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "tags": [
          "Analytics"
        ]
      }
    },
    "/api/v1/analytics/distribution": {
      "get": {
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "tags": [
          "Analytics"
        ]
      }
    },
    "/api/v1/analytics/events": {
      "post": {
        "requestBody": {
          "content": {
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyticsEvent"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyticsEvent"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyticsEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "tags": [
          "Analytics"
        ]
      }
    },
    "/api/v1/analytics/physio": {
      "get": {
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "tags": [
          "Analytics"
        ]
      }
    },
    "/api/v1/analytics/summary": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "period",
            "schema": {
              "default": "30",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "tags": [
          "Analytics"
        ]
      }
    },
    "/api/v1/analytics/thresholds": {
      "get": {
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "tags": [
          "Analytics"
        ]
      }
    },
    "/api/v1/analytics/tops": {
      "get": {
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "tags": [
          "Analytics"
        ]
      }
    },
    "/api/v1/analytics/trends": {
      "get": {
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "tags": [
          "Analytics"
        ]
      }
    }
  }
}
