{
  "openapi": "3.0.1",
  "info": {
    "title": "Analytics Microservice API",
    "description": "BC-Analytics: read-only аналитика (проекции над Журналом и Соматикой). CEQRS, профиль Single.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/analytics/summary": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "30"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "operationId": "Analytics.Summary"
      }
    },
    "/api/v1/analytics/correlations": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "operationId": "Analytics.Correlations"
      }
    },
    "/api/v1/analytics/tops": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "operationId": "Analytics.Tops"
      }
    },
    "/api/v1/analytics/distribution": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "operationId": "Analytics.Distribution"
      }
    },
    "/api/v1/analytics/thresholds": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "operationId": "Analytics.Thresholds"
      }
    },
    "/api/v1/analytics/trends": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "operationId": "Analytics.Trends"
      }
    },
    "/api/v1/analytics/physio": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "operationId": "Analytics.Physio"
      }
    },
    "/api/v1/analytics/events": {
      "post": {
        "tags": [
          "Analytics"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyticsEvent"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyticsEvent"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyticsEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "operationId": "Analytics.Events"
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyticsEvent": {
        "type": "object",
        "properties": {
          "eventType": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "nullable": true
          },
          "record": {
            "$ref": "#/components/schemas/JournalRecord"
          },
          "stress": {
            "type": "integer",
            "format": "int32"
          },
          "sleepScore": {
            "type": "integer",
            "format": "int32"
          },
          "t": {
            "type": "string",
            "nullable": true
          },
          "hr": {
            "type": "integer",
            "format": "int32"
          },
          "bodyBattery": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "JournalRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "startedAt": {
            "type": "string",
            "nullable": true
          },
          "durationMin": {
            "type": "integer",
            "format": "int32"
          },
          "orgasms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrgasmDto"
            },
            "nullable": true
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "fantasies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "place": {
            "type": "string",
            "nullable": true
          },
          "partners": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OrgasmDto": {
        "type": "object",
        "properties": {
          "participant": {
            "type": "string",
            "nullable": true
          },
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "rating": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
