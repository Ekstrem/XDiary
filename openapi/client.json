        "responses": {
          "200": {
            "description": "ok — новый номер: тело id, version, phone, otpExpiresAt, verified, delivery"
          },
          "400": {
            "description": "validation телефона — тело: СТРОКА"
          },
          "409": {
            "description": "номер уже зарегистрирован: тело СТРУКТУРИРОВАННОЕ {error, clientId, delivery}, код переотправлен; 429 при лимите"
          },
          "429": {
            "description": "лимит переотправки: 1/60с на клиента, 5/час на номер"
          }
        },
        "operationId": "Client.Register",
        "security": []
      }
    },
