            "Address": "http://somatic-series:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        },
        "HealthChecks": {
          "Passive": {
            "Enabled": true,
            "Policy": "ConsecutiveFailures",
            "FailureThreshold": 3,
            "ReactivationPeriod": "00:00:30"
          }
        }
      },
      "daily-metrics": {
