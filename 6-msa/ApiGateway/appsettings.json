{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "Journal": "http://journal:8080",
    "DailyMetrics": "http://daily-metrics:8080"
  },
  "ReverseProxy": {
    "Routes": {
      "journal": {
        "ClusterId": "journal",
        "Match": {
          "Path": "/api/v1/journal/{**catch-all}"
        }
      },
      "partners": {
        "ClusterId": "partners",
        "Match": {
          "Path": "/api/v1/partners/{**catch-all}"
        }
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/catalog/{**catch-all}"
        }
      },
      "somatic-series": {
        "ClusterId": "somatic-series",
        "Match": {
          "Path": "/api/v1/somatic-series/{**catch-all}"
        }
      },
      "daily-metrics": {
        "ClusterId": "daily-metrics",
        "Match": {
          "Path": "/api/v1/daily-metrics/{**catch-all}"
        }
      },
      "garmin-gateway": {
        "ClusterId": "garmin-gateway",
        "Match": {
          "Path": "/api/v1/garmin-gateway/{**catch-all}"
        }
      },
      "apple-health-gateway": {
        "ClusterId": "apple-health-gateway",
        "Match": {
          "Path": "/api/v1/apple-health-gateway/{**catch-all}"
        }
      },
      "analytics": {
        "ClusterId": "analytics",
        "Match": {
          "Path": "/api/v1/analytics/{**catch-all}"
        }
      },
      "privacy": {
        "ClusterId": "privacy",
        "Match": {
          "Path": "/api/v1/privacy/{**catch-all}"
        }
      },
      "portability": {
        "ClusterId": "portability",
        "Match": {
          "Path": "/api/v1/portability/{**catch-all}"
        }
      },
      "clients": {
        "ClusterId": "clients",
        "Match": {
          "Path": "/api/v1/clients/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "journal": {
        "Destinations": {
          "d1": {
            "Address": "http://journal:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:05"
        },
        "HealthChecks": {
          "Passive": {
            "Enabled": true,
            "Policy": "ConsecutiveFailures",
            "FailureThreshold": 2,
            "ReactivationPeriod": "00:00:10"
          }
        }
      },
      "partners": {
        "Destinations": {
          "d1": {
            "Address": "http://partners:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:05"
        },
        "HealthChecks": {
          "Passive": {
            "Enabled": true,
            "Policy": "ConsecutiveFailures",
            "FailureThreshold": 2,
            "ReactivationPeriod": "00:00:10"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "d1": {
            "Address": "http://catalog:8080/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:05"
        },
        "HealthChecks": {
          "Passive": {
            "Enabled": true,
            "Policy": "ConsecutiveFailures",
            "FailureThreshold": 2,
            "ReactivationPeriod": "00:00:10"
          }
        }
      },
      "somatic-series": {
