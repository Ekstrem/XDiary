diff --git a/.github/workflows/front-e2e-repeat.yml b/.github/workflows/front-e2e-repeat.yml
index 251fa26ec..6f297e861 100644
--- a/.github/workflows/front-e2e-repeat.yml
+++ b/.github/workflows/front-e2e-repeat.yml
@@ -157,6 +157,32 @@ jobs:
       # 2026-11-07: у падений E2E не было артефактов (`artifacts: 0` в #1785), поэтому
       # разбор шёл по строкам лога, а не по DOM/сети. Теперь трассы поднимаются всегда.
 
+      # TE-108 (@TL): гейт «история журнала остаётся разрешимой после soft-delete»
+      # существовал, но НЕ вызывался ни из одного workflow — проверялся вручную.
+      # Теперь идёт в каждом прогоне: --selftest (обе стороны на заглушках) + проба
+      # стенда по уже поднятому туннелю. rc=2 (стенд/токен недоступны) — warning,
+      # а не зелёный: «не измерено» не равно «в порядке».
+      - name: История журнала разрешима (TE-108)
+        if: always()
+        run: |
+          set -uo pipefail
+          src=0; rc=0
+          python3 9-tests/scripts/check_history_resolvable.py --selftest || src=$?
+          python3 9-tests/scripts/check_history_resolvable.py --base http://127.0.0.1:8080 || rc=$?
+          echo "history_resolvable: selftest rc=$src, probe rc=$rc"
+          if [ "$src" != "0" ]; then
+            echo "::error::check_history_resolvable --selftest rc=$src — сам гейт неисправен (TE-108)"
+            exit 1
+          fi
+          if [ "$rc" = "1" ]; then
+            echo "::error::история журнала НЕ разрешима: имя партнёра пропало после soft-delete (BE-099, TE-108)"
+            exit 1
+          fi
+          if [ "$rc" = "2" ]; then
+            echo "::warning::history_resolvable: НЕ ИЗМЕРЕНО (rc=2) — стенд или токен недоступны (TE-108)"
+            exit 0
+          fi
+
       # 2026-11-10 (@TE 11:45): классы падений — в лог, а не только в артефакт.
       - name: Классы падений (e2e_triage)
         if: always()
