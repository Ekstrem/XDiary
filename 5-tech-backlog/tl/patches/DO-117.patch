+              exit 1
+            }
+            # DO-113/DO-117: guard проверяется на КАЖДОЙ попытке, а не только до ретрая.
+            grc=0
+            python tools/gen_images_lock.py --check-digests || grc=$?
+            if [ "$grc" = "1" ]; then
+              echo "::error::lock-sync: digest-строк стало МЕНЬШЕ — откатываю lock (DO-113/DO-117)"
+              git checkout -- 7-deploy/images.lock
+              exit 1
+            fi
             git add 7-deploy/images.lock
             # @TE 09:50: «нечего коммитить» — это НЕ ошибка, и её нельзя глушить `|| true`
             # (иначе цикл из трёх попыток упадёт с ложным `::error::`, хотя причина — пустой диф).
