diff --git a/.github/workflows/lock-sync.yml b/.github/workflows/lock-sync.yml
index d21a09d19..7a42eafed 100644
--- a/.github/workflows/lock-sync.yml
+++ b/.github/workflows/lock-sync.yml
@@ -132,7 +132,22 @@ jobs:
             if git push; then exit 0; fi
             git fetch origin main
             git merge --no-edit origin/main || { echo "::error::конфликт в lock-sync"; exit 1; }
-            python tools/gen_images_lock.py --write
+            # DO-117 (@TL): источник lock — РЕЕСТР, а не git-рендер.
+            # В git-рендере digest взять неоткуда (`merge_digests` сохраняет его только
