+CNI_LIST=""
+for c in "${HOME:-/root}/.config/cni/net.d/xdiary.conflist" /etc/cni/net.d/xdiary.conflist; do
+  [ -f "$c" ] && CNI_LIST="$CNI_LIST $c"
