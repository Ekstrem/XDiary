diff --git a/.github/workflows/pr-create.yml b/.github/workflows/pr-create.yml
index 26d85da97..a3f3dc75c 100644
--- a/.github/workflows/pr-create.yml
+++ b/.github/workflows/pr-create.yml
@@ -32,21 +32,27 @@ jobs:
           if gh pr view "$GITHUB_REF_NAME" --json number >/dev/null 2>&1; then
             echo "PR уже есть — чеки всё равно перезапускаем (@AR 03:43: dispatch обязан"
             echo "идти на КАЖДЫЙ пуш, иначе новый SHA остаётся без чеков)"
-            echo "has_pr=true" >> "$GITHUB_OUTPUT"
+            echo "created=false" >> "$GITHUB_OUTPUT"
           else
             gh pr create --base main --head "$GITHUB_REF_NAME" \
               --title "$GITHUB_REF_NAME: $(git log -1 --pretty=%s)" \
               --body "Авто-PR из ветки \`$GITHUB_REF_NAME\` (PDR-047)."
-            echo "has_pr=true" >> "$GITHUB_OUTPUT"
+            echo "created=true" >> "$GITHUB_OUTPUT"
           fi
       # Событие от `GITHUB_TOKEN` не порождает прогонов — запускаем чеки сами.
+      # Dispatch — ТОЛЬКО на создании (@TL 03:49): последующие пуши делают люди,
+      # и `pull_request` запускает чеки штатно (проверено: role/tl 00:32–00:45, все
+      # event=pull_request). Dispatch на каждом пуше дал бы дубли и `cancelled`
+      # из-за общей группы `concurrency` (класс DO-123).
+      # Семь workflow — все, у кого `pull_request` есть, а `push` только в `main`
+      # (@AR 03:47): иначе у авто-PR не будет guard/guard-tools/docs-budget/status-lint/ci-front.
       - name: Dispatch checks (иначе у авто-PR нет чеков)
-        if: steps.create.outputs.has_pr == 'true'
+        if: steps.create.outputs.created == 'true'
         env:
           GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         run: |
           set -uo pipefail
-          for wf in ci-guards.yml ci-backend.yml; do
+          for wf in ci-guards.yml ci-backend.yml ci-front.yml guard-paths.yml guard-tools.yml docs-budget.yml status-lint.yml; do
             echo "::notice::dispatch $wf --ref $GITHUB_REF_NAME"
             gh workflow run "$wf" --ref "$GITHUB_REF_NAME" || echo "::warning::$wf: dispatch не удался"
           done
