+# Файл остаётся от предыдущего запуска (другой пользователь/владелец) — берём mktemp.
+BODY="$(mktemp "/tmp/recreate-$SVC.body.XXXXXX")"
+RUNNER="$(mktemp "/tmp/recreate-$SVC.sh.XXXXXX")"
 
 python3 - "$DEPLOY_SH" "$SVC" "$BODY" <<'PY'
