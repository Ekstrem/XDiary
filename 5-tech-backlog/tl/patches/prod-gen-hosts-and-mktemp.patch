+            mkdir -p /opt/xdiary/tools
+            echo "$GENHOSTS_B64" | base64 -d > /opt/xdiary/tools/gen-hosts.py
+            echo "DO-129: gen-hosts.py доставлен из git ($(wc -l < /opt/xdiary/tools/gen-hosts.py) строк)"
             echo "$LEGACY_B64" | base64 -d > legacy-shims.sh
             [ -s legacy-shims.sh ] || { echo "::error::legacy-shims.sh пуст после декода — base64 повреждён"; exit 1; }
             chmod +x legacy-shims.sh
diff --git a/7-deploy/recreate-service.sh b/7-deploy/recreate-service.sh
index f1ab2a71d..522b2f9b6 100644
--- a/7-deploy/recreate-service.sh
+++ b/7-deploy/recreate-service.sh
@@ -129,8 +129,12 @@ if [ "${2:-}" = "--image" ]; then IMAGE_OVERRIDE="${3:-}"; [ -n "$IMAGE_OVERRIDE
 CONTAINER="xdiary-$SVC"
 cd "$DEPLOY_DIR" || die "нет $DEPLOY_DIR"
 
-BODY="/tmp/recreate-$SVC.body"
-RUNNER="/tmp/recreate-$SVC.sh"
+# DO-129 (@TL 2026-11-13 18:5x): фиксированные `/tmp/recreate-<svc>.*` ломали ОТКАТ:
+# в логе прод-прогона 43455070581 — `PermissionError: [Errno 13] Permission denied:
