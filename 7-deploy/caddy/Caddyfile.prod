# Caddyfile — PROD (VPS-1)

# Источник правды для прод-стенда. Применяется на VPS-1:
#   sudo cp Caddyfile.prod /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Отличие от dev: на проде нет явного обработчика корня — всё уходит в API-шлюз.
# Это зафиксированное состояние (снято с машины), а НЕ рекомендация.
# ФАКТ (проверено 2026-11-13, DO-067): `GET /` и `/js/app.js` на проде отдают **401**
# с `WWW-Authenticate: Bearer` — это Kestrel deny-by-default (ADR-026), а не 502:
# раньше шлюз отвечал 502, после выкатки fallback-политики отвечает 401. Прежняя
# формулировка «отдаёт 502» устарела и врала тому, кто читал файл как источник правды.
# Фронт (PWA) на проде — GitHub Pages, поэтому пользователи на `/` не ходят.

xdiary-vps1.taile0b6ee.ts.net {
	tls /etc/caddy/xdiary-vps1.taile0b6ee.ts.net.crt /etc/caddy/xdiary-vps1.taile0b6ee.ts.net.key

	# ЗАСЛОНКА ОТКЛЮЧЕНА 2026-11-10: попытка `@clients_list method GET && path /api/v1/clients*`
	# -> `respond 404` дала 404 на ВСЁ через Caddy (включая `/health`), то есть ломала внешний вход.
	# Откатено на проде из `/etc/caddy/Caddyfile.bak-do` (после отката: /health 200, /clients 401,
	# POST /clients 400). Причина перехвата не выяснена — нужен разбор `caddy adapt` на тестовом порту.
	# Список клиентов и так закрыт на двух слоях: шлюз 401 (ADR-026) + маршрут удалён в BC-Client (BE-064).
	# Вернуть только вместе с проверкой на отдельном порту, не на живом 443.

	# DO-062 (2026-11-11): access-log обязателен, иначе на вопрос «были ли внешние
	# обращения к X» ответить нечем — ровно так PII-инцидент 2026-11-10 остался без
	# фактов (в Caddyfile директивы `log` не было, Funnel своих логов не пишет).
	# `log` без аргументов пишет в stdout -> journald, отдельных прав/файлов не нужно.
	log

	# DO-076 шаг 3 (2026-11-05): публичный вход переведён на APIM-gateway.
	# `/health` остаётся на YARP: в APIM маршрута `/health` нет (404), а внешняя
	# проверка требует 200 — поэтому health идёт мимо APIM, как и раньше.
	# ADR-030 (Принято 2026-11-05): `/health` — liveness КРАЯ, его отдаёт Caddy,
	# а не приложение. Раньше здесь был `reverse_proxy 127.0.0.1:8080` (YARP) — то есть
	# единственная оставшаяся публичная нагрузка YARP. Ответ отличается заголовком
	# `Server: Caddy` вместо `Server: Kestrel` — по нему и проверяется, что прокси нет.
	handle /health* {
		respond "ok" 200
	}

	handle {
		reverse_proxy 127.0.0.1:18082
	}
}

# DO-076: Funnel проксирует в HTTP-апстрим; развилка повторена на loopback:8081.
http://:8081 {
	handle /health* {
		respond "ok" 200
	}

	handle {
		reverse_proxy 127.0.0.1:18082
	}

	log
}
