# Caddyfile — PROD (VPS-1)

# Источник правды для прод-стенда. Применяется на VPS-1:
#   sudo cp Caddyfile.prod /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Отличие от dev: на проде нет явного обработчика корня — всё уходит в API-шлюз.
# Это зафиксированное состояние (снято с машины), а НЕ рекомендация:
# `GET /` на проде тоже отдаёт 502, потому что у YARP нет маршрута на `/`.
# Фронт (PWA) на проде — GitHub Pages, поэтому пользователи на `/` не ходят.

xdiary-vps1.taile0b6ee.ts.net {
	tls /etc/caddy/xdiary-vps1.taile0b6ee.ts.net.crt /etc/caddy/xdiary-vps1.taile0b6ee.ts.net.key

	# ЗАСЛОНКА ОТКЛЮЧЕНА 2026-11-10: попытка `@clients_list method GET && path /api/v1/clients*`
	# -> `respond 404` дала 404 на ВСЁ через Caddy (включая `/health`), то есть ломала внешний вход.
	# Откатено на проде из `/etc/caddy/Caddyfile.bak-do` (после отката: /health 200, /clients 401,
	# POST /clients 400). Причина перехвата не выяснена — нужен разбор `caddy adapt` на тестовом порту.
	# Список клиентов и так закрыт на двух слоях: шлюз 401 (ADR-026) + маршрут удалён в BC-Client (BE-064).
	# Вернуть только вместе с проверкой на отдельном порту, не на живом 443.

	reverse_proxy 127.0.0.1:8080
}
