# XDiary — шаблон секретов для VPS-1 (podman).
# Скопируйте в secrets/.env и подставьте реальные значения.
# secrets/.env — в .gitignore (НЕ коммитится, репозиторий публичный).
# На сервере: chmod 600 secrets/.env
#
# Генерация значений:
#   openssl rand -base64 48   # JWT (HS256, >= 32 байт после base64)
#   openssl rand -hex 16      # пароль роли БД

# --- JWT (HS256) ---
# Подписывает токены сервис privacy, проверяет api-gateway. ДОЛЖНЫ совпадать.
Jwt__SigningKey=CHANGE_ME_base64_48_bytes

# --- Garmin Connect Personal API Key ---
GARMIN_API_KEY=GCDC_CHANGE_ME

# --- PostgreSQL (VPS-2, приватная сеть) ---
# Host в каждой строке = приватный IP VPS-2 (например 10.0.0.2), НЕ localhost.
# Пароли задаются при создании ролей на VPS-2 (см. ops/provision-vps2.sh).
ConnectionStrings__JournalDb=Host=10.0.0.2;Port=5432;Database=journal;Username=journal;Password=CHANGE_ME_journal
ConnectionStrings__PartnersDb=Host=10.0.0.2;Port=5432;Database=partners;Username=partners;Password=CHANGE_ME_partners
ConnectionStrings__CatalogDb=Host=10.0.0.2;Port=5432;Database=catalog;Username=catalog;Password=CHANGE_ME_catalog
ConnectionStrings__SomaticSeriesDb=Host=10.0.0.2;Port=5432;Database=somatic_series;Username=somatic_series;Password=CHANGE_ME_somatic_series
ConnectionStrings__DailyMetricsDb=Host=10.0.0.2;Port=5432;Database=daily_metrics;Username=daily_metrics;Password=CHANGE_ME_daily_metrics
ConnectionStrings__GarminGatewayDb=Host=10.0.0.2;Port=5432;Database=garmin_gateway;Username=garmin_gateway;Password=CHANGE_ME_garmin_gateway
ConnectionStrings__AppleHealthGatewayDb=Host=10.0.0.2;Port=5432;Database=apple_health_gateway;Username=apple_health_gateway;Password=CHANGE_ME_apple_health_gateway
ConnectionStrings__PrivacyDb=Host=10.0.0.2;Port=5432;Database=privacy;Username=privacy;Password=CHANGE_ME_privacy
ConnectionStrings__PortabilityDb=Host=10.0.0.2;Port=5432;Database=portability;Username=portability;Password=CHANGE_ME_portability
# analytics — read-only (query-обработчики), БД не подключает; строка не обязательна.
