# dev-оверлей для E2E: НЕ секреты, а режим тестового OTP.
#
# Зачем файл, а не ручная правка на сервере (@TL 2026-11-07 11:12):
#   * dev работает в `ASPNETCORE_ENVIRONMENT=Single`, а `TestOtpPolicy.Resolve`
#     (`6-msa/BC-Client/src/Client.Application/TestOtpPolicy.cs:8`) отдаёт тестовый код
#     только в `Development` ИЛИ при `Clients:AllowTestOtpOutsideDev=true`;
#   * без флага `verify(000000)` на dev возвращает 400, и блокирующий `receipt-be092`
#     (он в `needs` deploy-prod) не проходит;
#   * прод этот файл НЕ получает: шаг деплоя dev и прод-шаг — разные.
#
# Формат: KEY=VALUE, дописывается в secrets/.env идемпотентно (без дублей).
Clients__AllowTestOtpOutsideDev=true
CLIENTS__TESTOTP=000000
